# Dexscreener pair endpoint (example format: https://api.dexscreener.com/latest/dex/pairs/solana/<PAIR_ADDRESS>)
DEXSCREENER_PAIR_URL=

# Dip threshold (0.25 = 25%)
DIP_THRESHOLD=0.25

# Polling interval ms
POLL_MS=15000

# Optional: Discord webhook URL
DISCORD_WEBHOOK=

# Optional: AI text generation (OpenAI-compatible endpoint)
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
